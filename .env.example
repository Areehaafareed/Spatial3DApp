# Copy this file to .env and fill in your values.
# Expo inlines EXPO_PUBLIC_* variables at build time — restart the dev server after changes.

# Your Meshy.ai API key (https://dashboard.meshy.ai → API Keys)
EXPO_PUBLIC_MESHY_KEY=

# Backend base URL (the /api suffix is required).
#   Local dev:   http://<your-lan-ip>:5000/api      (e.g. http://192.168.1.15:5000/api)
#   Production:  https://<your-site>.netlify.app/api
EXPO_PUBLIC_API_URL=http://192.168.1.15:5000/api
